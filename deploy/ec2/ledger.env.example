# /etc/longhand/ledger.env — production settings for the ledger service.
# Every variable is documented in docs/DEPLOY.md and .env.example.

DATABASE_URL=postgres://longhand:CHANGE_ME@your-rds-endpoint:5432/longhand
DATABASE_SCHEMA=public

AUTH_MODE=cognito
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_TOKEN_USE=access
AWS_REGION=eu-west-1

WITNESS_SIGNER=kms
WITNESS_KMS_KEY_ID=alias/longhand-witness

# The web app's origin(s) on Amplify.
CORS_ORIGINS=https://main.dxxxxxxxxxxxx.amplifyapp.com

MODEL_ADAPTER=claude
AGENT_MODEL_FULL=opus
AGENT_MODEL_QUICK=sonnet
# The Claude Code CLI inside the container authenticates with an API key.
ANTHROPIC_API_KEY=sk-ant-...

PRELOAD_PROJECTS=0
WITNESS_EMBED_EVERY_COMMITS=256
WITNESS_EMBED_INTERVAL_MS=600000
