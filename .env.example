# Copy to .env for local development. `pnpm dev:setup` creates the witness keys under .dev/.

# Postgres read model (docker compose up -d)
DATABASE_URL=postgres://longhand:longhand@localhost:5434/longhand

# Auth: "dev" signs in a fixed dev user with no external calls; "cognito" in prod.
AUTH_MODE=dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# Ports
WEB_PORT=3100
LEDGER_PORT=3200
DURABLE_STREAMS_URL=http://localhost:3300
LEDGER_URL=http://localhost:3200

# Witness signing (ECDSA P-256). Locally a PEM key pair; prod uses AWS KMS.
WITNESS_SIGNER=file
WITNESS_KEY_PATH=.dev/witness-key.pem
WITNESS_PUBLIC_KEY_PATH=.dev/witness-pub.pem
WITNESS_KMS_KEY_ID=

# AI runtime: the local Claude Code CLI, run headlessly.
CLAUDE_BIN=claude
AGENT_MODEL_FULL=opus
AGENT_MODEL_QUICK=sonnet
