# Copy to .env for local development. `pnpm dev:setup` creates the witness keys under .dev/.

# Postgres read model (docker compose up -d)
DATABASE_URL=postgres://longhand:longhand@localhost:5434/longhand
# Schema for the read model (tests use one per test).
DATABASE_SCHEMA=public

# Auth: "dev" signs in a fixed dev user with no external calls; "cognito" in prod.
AUTH_MODE=dev
# Dev principal (AUTH_MODE=dev): every route is scoped by this account; human drafts carry this actor id.
DEV_ACCOUNT_ID=dev-account
DEV_USER_ID=dev-writer
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
# Which Cognito token the web app sends and the service verifies: access (default) or id.
COGNITO_TOKEN_USE=access
# Web app (AUTH_MODE=cognito): the Hosted UI domain, without https://, e.g.
# longhand.auth.eu-west-1.amazoncognito.com. The app client must be public (no
# secret) with the authorization code grant; PKCE is always used.
COGNITO_DOMAIN=
# Defaults: <WEB_ORIGIN>/auth/callback and <WEB_ORIGIN>/; scopes "openid email profile".
COGNITO_REDIRECT_URI=
COGNITO_LOGOUT_URI=
COGNITO_SCOPES=

# Ports
WEB_PORT=3100
LEDGER_PORT=3200
# Interface the ledger service listens on.
LEDGER_HOST=127.0.0.1
DURABLE_STREAMS_URL=http://localhost:3300
LEDGER_URL=http://localhost:3200
# Web app: the ledger service origin as the browser reaches it (default LEDGER_URL).
LEDGER_PUBLIC_URL=
# Web app: its own public origin (default http://localhost:WEB_PORT), for Cognito redirects.
WEB_ORIGIN=
# Origin agent sessions post their drafts back to (default http://LEDGER_HOST:LEDGER_PORT).
LEDGER_INTERNAL_URL=
# Browser origins allowed by CORS (comma-separated; default http://localhost:WEB_PORT).
CORS_ORIGINS=
# Stream path prefix on the Durable Streams server, and where `dev` keeps stream data.
DURABLE_STREAMS_PREFIX=longhand
DURABLE_STREAMS_DATA_DIR=.dev/streams

# Witness signing (ECDSA P-256). Locally a PEM key pair; prod uses AWS KMS.
WITNESS_SIGNER=file
WITNESS_KEY_PATH=.dev/witness-key.pem
WITNESS_PUBLIC_KEY_PATH=.dev/witness-pub.pem
WITNESS_KMS_KEY_ID=
# AWS region for KMS (falls back to COGNITO_REGION).
AWS_REGION=
# Embedded ChainHeadWitnessed cadence: every N commits, and every M ms when commits arrived (0 disables).
WITNESS_EMBED_EVERY_COMMITS=256
WITNESS_EMBED_INTERVAL_MS=600000

# AI runtime: the local Claude Code CLI, run headlessly.
CLAUDE_BIN=claude
AGENT_MODEL_FULL=opus
AGENT_MODEL_QUICK=sonnet
# claude (default) or mock (canned script, for e2e tests and offline demos).
MODEL_ADAPTER=claude
# Delay between mock steps so annotations visibly stream (ms).
MOCK_STEP_DELAY_MS=0
# Start an agent session for every FeedbackRequested / DiscussRequested (1/0).
AGENT_AUTOSTART=1
# Fold every project at startup instead of on first use (1/0).
PRELOAD_PROJECTS=0
